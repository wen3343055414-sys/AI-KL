# Workbench: listener and persistent storage
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
APP_VERSION=development
COOKIE_SECURE=false

# Model gateway: configure the actual service address and one shared secret.
# MODEL_GATEWAY_URL=https://models.example.com/internal/model
# MODEL_BRIDGE_TOKEN=<64 hexadecimal characters; generate independently>
# MODEL_BRIDGE_TOKEN_FILE=/run/secrets/model-bridge-token

# Administration: set the externally visible origin when exposing the console.
ADMIN_HOST=0.0.0.0
ADMIN_PORT=3100
ADMIN_DATA_DIR=./admin/data
# ADMIN_ORIGIN=https://admin.example.com
# ADMIN_ALLOWED_HOSTS=models:3100
WORKBENCH_ORIGIN=http://127.0.0.1:3000

# Credential encryption: keep this key separate from the database and bridge token.
# SECRET_ENCRYPTION_KEY=<64 hexadecimal characters; generate independently>
# SECRET_ENCRYPTION_KEY_FILE=/run/secrets/credential-encryption-key

# Optional generated-website listener; use an origin separate from both apps.
# WEBSITE_HOST=0.0.0.0
# WEBSITE_PORT=3200
# WEBSITE_ORIGIN=https://sites.example.com
